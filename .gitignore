# ==========================================
# UrbanFlo - .gitignore
# ==========================================

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.npm
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python & Backend
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Cache
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/

# Databases
backend/floodguard.db
*.sqlite3
*.db

# User Uploads (keep directory structure)
uploads/*
!uploads/.gitkeep

# Environment variables
.env
.env.local
.env.*.local
frontend/.env
backend/.env

# IDE & OS Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
*.tmp
*.temp